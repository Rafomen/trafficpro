# Telegram Bot Configuration
# 1. Создай бота через @BotFather в Telegram -> /newbot -> получи токен
# 2. Узнай свой chat_id: напиши боту @userinfobot (или @getmyid_bot), он пришлёт твой ID

TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Node Environment
NODE_ENV=production
