{
  "name": "trafficpro",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "trafficpro.net", "custom_domain": true },
    { "pattern": "www.trafficpro.net", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
